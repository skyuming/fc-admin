## 开发环境

# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV='development'

VITE_APP_TITLE = '{{PROJECT_TITLE}}'
VITE_APP_PORT = 3000
VITE_APP_BASE_API = '/dev-api'
VITE_LIVELIHOOD_API = '/dev-api'
VITE_ROUTE_BASE='/'
VITE_HAVE_VIDEO='1' ## 目前只有幸福邻里房需要,用于右上角用户下载培训视频 1-显示，0-不显示,显示必须配置下面的图片地址前缀
VITE_IMGURL='https://allzone.zuma580.com/static/imagesFuture/' ## 图片地址前缀
## VITE_LOGIN_TYPE 登陆方式：1-账号密码登录（密码明文；前端绘制验证码），2-手机号验证码登录，3-浙征订扫码登录:必须配置下面两个参数 (多个用逗号隔开)， 4-账号密码登录（密码加密；从接口获取验证码）， 5-第三方统一平台登录（目前只有西兴有）
VITE_LOGIN_TYPE='1,2,3,4'
## VITE_PUBLIC_KEY 登录密码加密用的公钥，发布正式环境时对应的公钥找后端（孙雷）要
VITE_PUBLIC_KEY=''
# 测试公钥：
# 幸福邻里坊公钥：
# 西兴街道公钥：
# 长河街道公钥：

# VITE_THIRD_LOGIN_URL='https://xxwlsq.hhtz.gov.cn/szxx/webindex/login' ## VITE_LOGIN_TYPE=5,第三方统一平台登录账号token过期后跳转的登录页地址
VITE_ENABLE_SPECIAL_PAGE='1' ## 是否启用特殊页面，1-启用，0-不启用（默认不启用），启用后可以访问台州路、蚕花园驾驶舱页面
VITE_MOCK=false ## 是否启用Mock模式，true-启用Mock数据，false-调用真实API

## 浙征订应用标识和回调地址,下面是幸福邻里坊的
VITE_APP_client_id = 'xfllf_dingoa'
VITE_APP_redirect_uri = 'https://xfllf.zuma580.com/xfllf/newweb'
VITE_DATA_INTEGRITY=1

# ============================================
# HMAC 认证凭证（必填）
# ============================================
# 用于登录接口的 HMAC 签名认证，请联系后端获取
VITE_HMAC_USER='swkj_web'      # 联系后端获取实际值
VITE_HMAC_KEY='swkj1111'       # 联系后端获取实际值
