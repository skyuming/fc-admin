## 开发环境
## 变量必须以 VITE_ 为前缀才能暴露给外部读取

NODE_ENV='development'

# 应用标题(浏览器标签 / 侧边栏 LOGO)
VITE_APP_TITLE = '{{PROJECT_TITLE}}'

# Vite dev server 端口
VITE_APP_PORT = {{DEV_PORT}}

# 后端 API baseURL(mock 模式下忽略)
VITE_APP_BASE_API = '/dev-api'

# 路由 base(可选,默认 /)
VITE_ROUTE_BASE = '/'

# === Mock 模式 ===
# true  -> 使用内置 axios-mock-adapter 拦截 HTTP 请求,登录可用 admin / admin123
# false -> 走真实后端
VITE_USE_MOCK = 'true'

# === 登录跳转后回跳路径前缀(可选) ===
# VITE_THIRD_LOGIN_URL = ''

# === 特殊页面开关(可选,默认 0) ===
# 1 = 打包台州路/蚕花园驾驶舱特殊页面, 0 = 排除
VITE_ENABLE_SPECIAL_PAGE = '0'
