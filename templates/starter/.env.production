## 生产环境
NODE_ENV='production'

VITE_APP_PORT = 3000
VITE_APP_TITLE = '#{sysTitle}' ## 页面标题
VITE_APP_BASE_API = '#{sysPath}' ## 接口地址
VITE_APP_BASE_AIAPI = '#{sysPathAI}' ## AI接口地址

VITE_LIVELIHOOD_API = '#{livelihoodPath}'
VITE_ROUTE_BASE='#{sysBase}' ## 路由地址
VITE_IMGURL='#{imgUrl}' ## 图片地址前缀
VITE_HAVE_VIDEO='#{haveVideo}' ## 目前只有幸福邻里房需要,用于右上角用户下载培训视频 1-显示，0-不显示
VITE_ENABLE_SPECIAL_PAGE='0' ## 是否启用特殊页面，发布前手动改成 0/1；为 0 时不打包台州路、蚕花园相关页面
VITE_MOCK=false ## 是否启用Mock模式，true-启用Mock数据，false-调用真实API
VITE_LOGIN_TYPE='#{sysLoginType}' ## 登陆方式：1-账号密码登录（密码明文；前端绘制验证码），2-手机号验证码登录，3-浙征订扫码登录:必须配置下面两个参数 (多个用逗号隔开)， 4-账号密码登录（密码加密；从接口获取验证码）， 5-第三方统一平台登录（目前只有西兴有）
VITE_PUBLIC_KEY='#{rsaPublicKey}' ## 登录密码加密用的公钥
# VITE_THIRD_LOGIN_URL='#{sysThirdLoginUrl}' ## VITE_LOGIN_TYPE=5,第三方统一平台登录账号token过期后跳转的登录页地址
VITE_DATA_INTEGRITY='#{dataIntegrity}' ## 数据是否完整
## 浙征订应用标识和回调地址
VITE_APP_client_id = '#{clientId}'
VITE_APP_redirect_uri = '#{redirectUri}'

# ============================================
# HMAC 认证凭证（必填）
# ============================================
# 用于登录接口的 HMAC 签名认证，请联系后端获取
VITE_HMAC_USER='#{hmacUser}'      # 联系后端获取实际值
VITE_HMAC_KEY='#{hmacKey}'       # 联系后端获取实际值


